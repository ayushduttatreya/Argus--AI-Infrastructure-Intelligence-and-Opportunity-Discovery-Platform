# ==============================================================================
# ARGUS Environment Configuration Template (v1)
# Copy this file to .env and populate with actual credentials.
# NEVER commit .env or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & API Settings
# ------------------------------------------------------------------------------
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
APP_SECRET_KEY=change_this_to_a_secure_random_string_at_least_32_chars

# ------------------------------------------------------------------------------
# 2. Database & Cache (PostgreSQL + pgvector, Redis)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus_dev_password
DATABASE_URL=postgresql+asyncpg://argus:argus_dev_password@localhost:5432/argus

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Object Storage (MinIO locally / S3 in production)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=argus-raw-documents
STORAGE_SECURE=false

# ------------------------------------------------------------------------------
# 4. Temporal Workflow Orchestration
# ------------------------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=argus-research-tasks

# ------------------------------------------------------------------------------
# 5. LLM Gateway & Provider Configuration (LiteLLM)
# ------------------------------------------------------------------------------
# Upstream Master Keys (Held securely by LiteLLM Proxy only)
OPENROUTER_API_KEY=
FALLBACK_OPENAI_API_KEY=

# LiteLLM Proxy Endpoint & Admin Key
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-master-key

# Internal Virtual Keys for the 8 Agents (Managed by LiteLLM)
AGENT_KEY_COMPANY_SCANNER=sk-argus-company-scanner
AGENT_KEY_RESEARCH_SCANNER=sk-argus-research-scanner
AGENT_KEY_COMMUNITY_SCANNER=sk-argus-community-scanner
AGENT_KEY_HIRING_INTELLIGENCE=sk-argus-hiring-intelligence
AGENT_KEY_OPEN_SOURCE_INTEL=sk-argus-open-source-intel
AGENT_KEY_MARKET_INTELLIGENCE=sk-argus-market-intelligence
AGENT_KEY_ARCHITECTURE_EXTRACTOR=sk-argus-architecture-extractor
AGENT_KEY_NEGATIVE_SPACE=sk-argus-negative-space

# ------------------------------------------------------------------------------
# 6. Source Connectors (Live Evidence Sources)
# ------------------------------------------------------------------------------
# Open Source Intelligence
GITHUB_PERSONAL_ACCESS_TOKEN=

# Company Scanner
PRODUCT_HUNT_API_TOKEN=

# Research Scanner (arXiv requires no key; OpenAlex/Semantic Scholar optional keys for higher rate limits)
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Community Scanner (Subject to approved access)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=argus-research-bot/1.0

# ------------------------------------------------------------------------------
# 7. Authentication & Authorization (Keycloak / OIDC)
# ------------------------------------------------------------------------------
OIDC_ISSUER=http://localhost:8080/realms/argus
OIDC_CLIENT_ID=argus-api
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=argus-api

# ------------------------------------------------------------------------------
# 8. Observability & Tracing (OpenTelemetry & Langfuse)
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
